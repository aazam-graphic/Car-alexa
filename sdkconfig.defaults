# ESP32-S3 USB Host - Xbox 360 wireless receiver (Redgear Pro dongle)
# Console UART0 par hai (board ka USB-UART bridge). OTG port host ke liye.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# --- Car OS: 8MB PSRAM (N16R8 = octal) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# CONFIG_SPIRAM_MEMTEST is not set
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# malloc() stays internal; PSRAM only via explicit heap_caps_malloc(MALLOC_CAP_SPIRAM)
# (USB-OTG DMA cannot reach PSRAM - avoids USB stack corruption)
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# Board is N16R8 (8MB PSRAM verified at boot). Do NOT ignore a missing PSRAM:
# that Kconfig path also disables SPIRAM_TRY_ALLOCATE_WIFI_LWIP below.
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
# Internal DRAM is tight/fragmented after USB+TFT+audio init (~23 KB free,
# largest block ~7 KB). WiFi needs contiguous buffers, so allocate WiFi/LWIP
# buffers from PSRAM first and fall back to internal memory.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# SNTP-only workload: keep WiFi buffers modest (scan/connect/UDP is enough).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=2
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=3
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
# Task stacks MUST stay internal (ISR on PSRAM stack = crash on S3)
# CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY is not set
